# Copy to apps/server/.env and fill in DATABASE_URL.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Where per-IP limits read the client address: render (first X-Forwarded-For
# entry, which Render sets) or direct (the socket address, when nothing is in front).
CLIENT_IP_SOURCE=direct

# Comma-separated list of web origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Shared free AI tier. Create a key at https://aistudio.google.com/apikey and check
# the project's limits at https://aistudio.google.com/rate-limit. Leave empty to turn
# the shared tier off; people can still use their own key.
GEMINI_API_KEY=
AI_DEFAULT_MODEL=gemini-3.5-flash-lite
# Shared-tier requests per day: everyone together, per visitor, per project.
AI_GLOBAL_DAILY_REQUESTS=400
AI_PER_IP_DAILY_REQUESTS=30
AI_PER_PROJECT_DAILY_REQUESTS=60
# Shared-tier requests everyone together may start in any 60 seconds. Keep it
# under the model's RPM on the rate-limit page (about 80% of it).
AI_GLOBAL_REQUESTS_PER_MINUTE=12
# How many of those may be AI agent steps; the one-shot helpers keep the rest.
AI_AGENT_REQUESTS_PER_MINUTE=6

# Neon Postgres connection string, e.g.
# postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
