{
  "name": "collabcode",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @collabcode/shared && npm run build -w @collabcode/server && npm run build -w @collabcode/web",
    "build:shared": "npm run build -w @collabcode/shared",
    "dev": "npm run build:shared && concurrently -n shared,server,web -c gray,blue,magenta \"npm:dev:shared\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:shared": "npm run dev -w @collabcode/shared",
    "dev:server": "npm run dev -w @collabcode/server",
    "dev:web": "npm run dev -w @collabcode/web",
    "test": "npm run build:shared && vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
